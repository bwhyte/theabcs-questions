{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "theabcs-questions",
  "main": "src/index.js",
  "compatibility_date": "2025-10-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "run_worker_first": ["/api/*"]
  },
  "vars": {
    "SUPABASE_URL": "https://bntmsboxsjbxnkcbjbvp.supabase.co",
    // Publishable key: safe to commit. Row level security limits it to reading and adding questions.
    "SUPABASE_PUBLISHABLE_KEY": "sb_publishable_V3pSpFuGBrxIgW0fmeYM9g_VgC5NPfI"
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["QuestionBoard"] }]
}
