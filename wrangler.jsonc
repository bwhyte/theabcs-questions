{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "theabcs-questions",
  "main": "src/index.js",
  "compatibility_date": "2025-10-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "run_worker_first": ["/api/*"]
  },
  "durable_objects": {
    "bindings": [{ "name": "BOARD", "class_name": "QuestionBoard" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["QuestionBoard"] }]
}
